# ==============================================================================
# ERP Syailendra Group — Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local containing real credentials into Git.
# ==============================================================================

# Backend Odoo 18 Connection
ODOO_BASE_URL="YOUR_ODOO_URL"
ODOO_DB="YOUR_ODOO_DB_NAME"
ODOO_USERNAME="YOUR_ODOO_USERNAME"
ODOO_PASSWORD="YOUR_ODOO_PASSWORD"
ODOO_API_KEY="YOUR_ODOO_API_KEY"

# Public Application Metadata
NEXT_PUBLIC_APP_NAME="ERP Syailendra Group"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="id"
NEXT_PUBLIC_DEFAULT_THEME="light"

# Security & Session Configuration
# Cookie encryption secret (generate a secure random 32-character string for production)
SESSION_SECRET="your_secure_random_session_secret_32_chars_min"

# Public partner portal (/mitra) session signing secret. Must differ from SESSION_SECRET.
PARTNER_SESSION_SECRET="your_secure_random_partner_session_secret_32_chars_min"

# Cloudflare Turnstile CAPTCHA Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,demo.octalectzz.my.id,app.syailendra.group

# Media & File Upload Configuration
NEXT_PUBLIC_MAX_IMAGE_SIZE_MB="2"
NEXT_PUBLIC_MAX_VIDEO_SIZE_MB="50"
NEXT_PUBLIC_ACCEPTED_IMAGE_TYPES="image/jpeg,image/png,image/webp"

# ==============================================================================
# Accurate Online API (Master Data Integration — ERP Syailendra Group)
# Real credential values are transferred from SSOT:
#   ddistillers-vps:/opt/app/data/hermes/.env
# They live ONLY in .env.local (chmod 600, gitignored via .env*).
# NEVER commit real values into Git.
# ==============================================================================

ACCURATE_API_TOKEN="YOUR_ACCURATE_API_TOKEN"
ACCURATE_APP_KEY="YOUR_ACCURATE_APP_KEY"
ACCURATE_CLIENT_ID="YOUR_ACCURATE_CLIENT_ID"
ACCURATE_CLIENT_SECRET="YOUR_ACCURATE_CLIENT_SECRET"
ACCURATE_HOST="https://zeus.accurate.id"
ACCURATE_SIGNATURE_SECRET="YOUR_ACCURATE_SIGNATURE_SECRET"

# Demo Credentials
DEMO_EMAIL="YOUR_ACCURATE_DEMO_EMAIL"
DEMO_PASSWORD="YOUR_ACCURATE_DEMO_PASSWORD"

# ==============================================================================
# Supabase Platform Auth (self-hosted: https://database.syailendra.group)
# NEXT_PUBLIC_* are baked at build time — run a fresh build after changing them.
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://database.syailendra.group"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable/anon key from the Supabase .env>"

# Media object storage (server-only; never NEXT_PUBLIC_*, never committed with values)
SUPABASE_STORAGE_URL=""
SUPABASE_STORAGE_BUCKET=""
SUPABASE_STORAGE_ACCESS_KEY_ID=""
SUPABASE_STORAGE_SECRET_ACCESS_KEY=""
SUPABASE_STORAGE_REGION=""

# Non-production only: allow Cloudflare dummy keys for automated tests. Ignored in production builds.
# Deployment marker. Only APP_ENV=test + TURNSTILE_ALLOW_TEST_KEYS=true + a loopback
# NEXT_PUBLIC_APP_URL permits Cloudflare dummy keys; production must stay closed.
APP_ENV=production
TURNSTILE_ALLOW_TEST_KEYS=false
