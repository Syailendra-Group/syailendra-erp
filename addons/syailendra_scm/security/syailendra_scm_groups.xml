<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="module_category_syailendra_scm" model="ir.module.category">
        <field name="name">Syailendra SCM</field>
        <field name="description">Hak akses modul rantai pasok dan ketertelusuran.</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_scm_user" model="res.groups">
        <field name="name">SCM User</field>
        <field name="category_id" ref="module_category_syailendra_scm"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Mencatat data panen, penyulingan, dan melihat master data.</field>
    </record>

    <record id="group_scm_manager" model="res.groups">
        <field name="name">SCM Manager</field>
        <field name="category_id" ref="module_category_syailendra_scm"/>
        <field name="implied_ids" eval="[(4, ref('group_scm_user'))]"/>
        <field name="comment">Mengelola seluruh master data, evaluasi, dan audit pemasok.</field>
    </record>

    <record id="group_qc_analyst" model="res.groups">
        <field name="name">QC Analyst</field>
        <field name="category_id" ref="module_category_syailendra_scm"/>
        <field name="implied_ids" eval="[(4, ref('group_scm_user'))]"/>
        <field name="comment">Melakukan pengujian laboratorium dan menginput hasil QC.</field>
    </record>

    <record id="group_qc_manager" model="res.groups">
        <field name="name">QC Manager</field>
        <field name="category_id" ref="module_category_syailendra_scm"/>
        <field name="implied_ids" eval="[(4, ref('group_qc_analyst'))]"/>
        <field name="comment">Mengotorisasi status mutu dan penerbitan CoA.</field>
    </record>
    <record id="group_scm_api" model="res.groups">
        <field name="name">SCM API Reader</field>
        <field name="category_id" ref="module_category_syailendra_scm"/>
        <field name="comment">Akun integrasi: baca-saja seluruh model SCM, tanpa hak tulis.</field>
    </record>

</odoo>