# --- Backend Odoo 18.0 Connection Parameters ---
# Base internal or public URL of the Odoo 18 server
ODOO_BASE_URL="http://10.10.0.238:8069"

# Target Odoo database name
ODOO_DB="odoo_dev"

# System service account credentials (used for background sync & unauthenticated queries)
ODOO_USERNAME="octalectzz@gmail.com"
ODOO_PASSWORD="your_secure_odoo_password_here"
ODOO_API_KEY=""

# --- Public Application Metadata ---
NEXT_PUBLIC_APP_NAME="ERP Syailendra Group"
NEXT_PUBLIC_APP_URL="https://code.octalectzz.my.id"
NEXT_PUBLIC_DEFAULT_LOCALE="id"
NEXT_PUBLIC_DEFAULT_THEME="light"

# --- Security & Session Configuration ---
# Cookie encryption secret (generate a secure random 32-character string for production)
SESSION_SECRET="your_secure_random_session_secret_32_chars_min"
