<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Multi-company: entitas hanya melihat data perusahaannya, holding
         memakai company switcher (company_ids) untuk konsolidasi grup. -->

    <record id="rule_syailendra_crop_company" model="ir.rule">
        <field name="name">Komoditas: multi-perusahaan</field>
        <field name="model_id" ref="model_syailendra_crop"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

